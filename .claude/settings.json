{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run check)",
      "Bash(npm run serve)",
      "Bash(node --test *)",
      "Bash(node --check *)",
      "Bash(python3 scripts/smoke.py *)",
      "Bash(python3 scripts/smoke.py)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)"
    ]
  }
}
